# Inactive template. Requires explicit approval and Pages source migration.
name: Authorized Pages production
on:
  workflow_dispatch:
    inputs:
      release_sha:
        description: Exact approved main commit SHA
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: pages-publication
  cancel-in-progress: false
jobs:
  regression:
    uses: ./.github/workflows/exact-release-regression.yml
    with:
      release_sha: ${{ github.sha }}
  build:
    needs: regression
    if: github.ref == 'refs/heads/main' && vars.PAGES_RELEASE_ENABLED == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - env:
          REQUESTED: ${{ inputs.release_sha }}
          CURRENT: ${{ github.sha }}
        run: |
          test "$REQUESTED" = "$CURRENT"
          test "$(git rev-parse HEAD)" = "$CURRENT"
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '22'
      - run: node scripts/release-artifact.mjs "$GITHUB_SHA" "$RUNNER_TEMP/site"
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
        with:
          path: ${{ runner.temp }}/site
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    permissions:
      contents: read
      pages: write
      id-token: write
    steps:
      - env:
          GH_TOKEN: ${{ github.token }}
          EXPECTED: ${{ github.sha }}
        run: |
          test "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)" = "$EXPECTED"
      - id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
